{
  "$defs": {
    "AccessConfig": {
      "description": "Distances at which the access score reaches 0 (spec FR-P11).",
      "properties": {
        "road_far_km": {
          "title": "Road Far Km",
          "type": "number"
        },
        "airport_far_km": {
          "title": "Airport Far Km",
          "type": "number"
        }
      },
      "required": [
        "road_far_km",
        "airport_far_km"
      ],
      "title": "AccessConfig",
      "type": "object"
    },
    "ModisConfig": {
      "description": "Which MODIS composites to read, and when a cell has too few of them to keep a value.",
      "properties": {
        "months": {
          "default": [
            1,
            3,
            5,
            7,
            9,
            11
          ],
          "items": {
            "type": "integer"
          },
          "title": "Months",
          "type": "array"
        },
        "min_valid_share": {
          "default": 0.2,
          "title": "Min Valid Share",
          "type": "number"
        }
      },
      "title": "ModisConfig",
      "type": "object"
    },
    "Region": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "lat_min": {
          "title": "Lat Min",
          "type": "number"
        },
        "lat_max": {
          "title": "Lat Max",
          "type": "number"
        },
        "lon_min": {
          "title": "Lon Min",
          "type": "number"
        },
        "lon_max": {
          "title": "Lon Max",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "lat_min",
        "lat_max",
        "lon_min",
        "lon_max"
      ],
      "title": "Region",
      "type": "object"
    },
    "RegionPreset": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "bbox"
      ],
      "title": "RegionPreset",
      "type": "object"
    },
    "ValidationConfig": {
      "description": "Settings for the validation report (spec section 8).",
      "properties": {
        "accept_top_share": {
          "default": 0.2,
          "title": "Accept Top Share",
          "type": "number"
        },
        "stretch_top_share": {
          "default": 0.1,
          "title": "Stretch Top Share",
          "type": "number"
        },
        "weight_change": {
          "default": 0.2,
          "title": "Weight Change",
          "type": "number"
        },
        "top_cells": {
          "default": 50,
          "title": "Top Cells",
          "type": "integer"
        }
      },
      "title": "ValidationConfig",
      "type": "object"
    }
  },
  "properties": {
    "grid_resolution_deg": {
      "title": "Grid Resolution Deg",
      "type": "number"
    },
    "region": {
      "$ref": "#/$defs/Region"
    },
    "region_presets": {
      "items": {
        "$ref": "#/$defs/RegionPreset"
      },
      "title": "Region Presets",
      "type": "array"
    },
    "site_window_km": {
      "title": "Site Window Km",
      "type": "number"
    },
    "target_quality": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "enum": [
          "measured",
          "literature",
          "physical"
        ]
      },
      "title": "Target Quality",
      "type": "object"
    },
    "confidence_bands": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "enum": [
          "high",
          "medium"
        ]
      },
      "title": "Confidence Bands",
      "type": "object"
    },
    "reference_year": {
      "title": "Reference Year",
      "type": "integer"
    },
    "access": {
      "$ref": "#/$defs/AccessConfig"
    },
    "cover_threshold": {
      "title": "Cover Threshold",
      "type": "number"
    },
    "analog_match_km": {
      "title": "Analog Match Km",
      "type": "number"
    },
    "novelty_km": {
      "default": 300.0,
      "title": "Novelty Km",
      "type": "number"
    },
    "modis": {
      "$ref": "#/$defs/ModisConfig",
      "default": {
        "months": [
          1,
          3,
          5,
          7,
          9,
          11
        ],
        "min_valid_share": 0.2
      }
    },
    "validation": {
      "$ref": "#/$defs/ValidationConfig",
      "default": {
        "accept_top_share": 0.2,
        "stretch_top_share": 0.1,
        "weight_change": 0.2,
        "top_cells": 50
      }
    }
  },
  "required": [
    "grid_resolution_deg",
    "region",
    "region_presets",
    "site_window_km",
    "target_quality",
    "confidence_bands",
    "reference_year",
    "access",
    "cover_threshold",
    "analog_match_km"
  ],
  "title": "RunConfig",
  "type": "object"
}
